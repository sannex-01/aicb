# ==============================================================================
# AICB Assistant Configuration
# All LLM providers, channels, payments, and storage are configured via the UI.
# ==============================================================================

APP_NAME="AICB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8422
APP_SECRET=""
AICB_DOMAIN="https://aicb.sannex.ng"

# Database (defaults to SQLite; set for PostgreSQL in production)
DATABASE_URL="postgresql+asyncpg://aicb_user:aicb_secure_pass@localhost:5432/aicb"

# Sannex AgentOS Sync & Telemetry (optional)
AICB_API_KEY=""
SANNEX_API_KEY=""
SANNEX_HOST="https://agentos.aicb.sannex.ng"
ENABLE_TELEMETRY=true
SYNC_INTERVAL_MINUTES=30
