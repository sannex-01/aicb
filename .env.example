# ==============================================================================
# AICB (AI Conversational Business Bot) Configuration
#
# Two ways to run AICB — pick one:
#   1. AgentOS-connected: one AICB instance per bot, managed from AgentOS's
#      dashboard. Prompts/catalog/knowledge sync in automatically; you only
#      need infra + AgentOS auth settings below.
#   2. Standalone: one AICB instance per business, with its own admin
#      dashboard at /_/admin (multiple agents, customers, catalog — no
#      AgentOS needed). Run first-run setup at /_/admin/setup instead of
#      filling in channel tokens here; see README.md.
#
# Copy this file to .env and fill in only what your setup needs — every
# section below says which mode it's for.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core (always required)
# ------------------------------------------------------------------------------
APP_NAME="AICB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8422
AICB_PORT=8422

# Signs standalone-admin login sessions (JWT). Required in production —
# without it, sessions fall back to a hardcoded default key, which is not
# safe once real admin accounts exist. Generate with: openssl rand -hex 32
APP_SECRET=""

# Defaults to local SQLite; set this for Postgres (Docker Compose provides
# one automatically — see docker-compose.yml).
# DATABASE_URL="postgresql+asyncpg://aicb_user:aicb_secure_pass_2026@postgres:5432/aicb"

# Base URL this instance is reachable at — used to build payment callback
# and webhook redirect URLs.
BOT_DOMAIN="https://aicb.sannex.ng"

# ------------------------------------------------------------------------------
# AI Brain — LLM Provider
#
# These are the DEFAULT keys used by any agent that doesn't set its own
# override key in the dashboard. In standalone mode, always fill these in
# here; in AgentOS-connected mode, per-bot prompt/model settings sync from
# AgentOS automatically but the API key itself still comes from here.
# ------------------------------------------------------------------------------
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Optional alternative providers (set LLM_PROVIDER to match):
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# ------------------------------------------------------------------------------
# Channels — WhatsApp & Telegram
#
# Per-agent WhatsApp/Telegram tokens are NOT set here — they're set per
# agent, in the dashboard (standalone: /_/admin Agents screen; AgentOS-
# connected: AgentOS's own bot settings). This keeps every agent's
# credentials independent, including on a single-agent instance.
#
# Only the webhook-level settings below stay in .env, since they apply to
# the whole instance regardless of how many agents share it.
# ------------------------------------------------------------------------------
META_APP_SECRET=""  # Meta App Secret — verifies X-Hub-Signature-256 on all inbound WhatsApp webhooks
META_VERIFY_TOKEN="aicb_webhook_verification_token_secret"  # your own value, entered when configuring the WhatsApp webhook in Meta's dashboard
TELEGRAM_WEBHOOK_SECRET=""  # your own value, sent as the Telegram webhook's secret_token when you register it

# ------------------------------------------------------------------------------
# Payments (always required — pick your gateway)
# ------------------------------------------------------------------------------
DEFAULT_PAYMENT_GATEWAY="paystack"
PAYSTACK_SECRET_KEY="sk_live_or_test_key"
PAYSTACK_PUBLIC_KEY="pk_live_or_test_key"

# Optional alternative gateways (set DEFAULT_PAYMENT_GATEWAY to match):
# FLUTTERWAVE_SECRET_KEY=""
# FLUTTERWAVE_PUBLIC_KEY=""
# FLUTTERWAVE_SECRET_HASH=""
# MONNIFY_API_KEY=""
# MONNIFY_SECRET_KEY=""
# MONNIFY_CONTRACT_CODE=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Product Image Storage (optional — leave blank to disable image upload/display)
#
# If unset, the product edit form won't ask for images and customers won't
# be sent broken image links. Fill in exactly one provider.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Alternative: Cloudflare R2 (set STORAGE_PROVIDER="cloudflare_r2")
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# AgentOS Integration (AgentOS-connected mode only — leave blank in standalone)
# ------------------------------------------------------------------------------
# Verifies inbound calls FROM AgentOS (catalog reads/writes, gateway-info,
# order lists, image uploads). Set to the SAME value as this bot's api_key
# in AgentOS's Identity settings (copy button) — every request is rejected
# until this is set.
AICB_API_KEY=""

# aicb authenticating itself TO AgentOS for prompt/catalog/knowledge sync —
# the opposite direction from AICB_API_KEY above.
SANNEX_API_KEY="snx_bot_xxxx"
SANNEX_HOST="https://agentos.aicb.sannex.ng"
ENABLE_TELEMETRY=true
SYNC_INTERVAL_MINUTES=30

# ------------------------------------------------------------------------------
# Human Escalation (optional)
# ------------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=""
# SUPPORT_PHONE_NUMBER="+2348000000000"
# SUPPORT_EMAIL="support@example.com"

# ------------------------------------------------------------------------------
# External Catalog Source (optional — defaults to the local database)
# ------------------------------------------------------------------------------
# CATALOG_SOURCE="bumpa"  # "local" | "paystack" | "bumpa"
# BUMPA_API_KEY=""
# BUMPA_STORE_ID=""
