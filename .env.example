# ==============================================================================
# AICB (AI Conversational Business Bot) Configuration
# ==============================================================================

# Application & Environment
APP_NAME="AICB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Bot Operating Mode: 'conversational' | 'interactive_flow' | 'hybrid'
BOT_MODE="hybrid"

# Database Configuration (SQLite default for zero-setup plug-and-play)
DATABASE_URL="sqlite+aiosqlite:///./aicb.db"

# Memory & Session Configuration
SESSION_EXPIRY_HOURS=24
MEMORY_WINDOW_SIZE=10

# ==============================================================================
# LLM Providers (API Keys & Baseline Config)
# ==============================================================================
# Active LLM Provider: 'gemini' | 'openai' | 'claude'
LLM_PROVIDER="gemini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# Baseline LLM Parameters (Can be dynamically overridden via AgentOS sync)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
DEFAULT_SYSTEM_PROMPT="You are a helpful, professional AI business assistant. You assist customers with product inquiries, order placement, payments, and general customer service. Always be concise, warm, and helpful."

# ==============================================================================
# Channels Configuration
# ==============================================================================

# WhatsApp Cloud API (Meta)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_BUSINESS_ACCOUNT_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="aicb_webhook_verification_token_secret"
WHATSAPP_FLOW_PRIVATE_KEY=""
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=""

# Telegram Bot API
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_PAYMENT_PROVIDER_TOKEN=""

# Slack / Escalations
SLACK_WEBHOOK_URL=""
SUPPORT_PHONE_NUMBER="+2348000000000"
SUPPORT_EMAIL="support@example.com"

# ==============================================================================
# Commerce & Catalog Providers
# ==============================================================================
# Catalog Source: 'local' | 'paystack' | 'bumpa'
CATALOG_SOURCE="local"

# Bumpa API
BUMPA_API_KEY=""
BUMPA_STORE_ID=""
BUMPA_API_BASE_URL="https://api.getbumpa.com/v1"

# ==============================================================================
# Payment Gateways (Webhooks & Checkout Links)
# ==============================================================================
# Default Payment Gateway: 'paystack' | 'flutterwave' | 'monnify' | 'stripe'
DEFAULT_PAYMENT_GATEWAY="paystack"

# Paystack (Payments & /product Catalog API)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CALLBACK_URL="https://yourdomain.com/payments/paystack/callback"

# Flutterwave
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_HASH=""

# Monnify
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="https://yourdomain.com/payments/stripe/success"
STRIPE_CANCEL_URL="https://yourdomain.com/payments/stripe/cancel"

# ==============================================================================
# Sannex Agent Telemetry & AgentOS Remote Sync
# ==============================================================================
SANNEX_API_KEY=""
SANNEX_HOST="https://api.sannex.ng"
SYNC_INTERVAL_HOURS=12
ENABLE_TELEMETRY=true
