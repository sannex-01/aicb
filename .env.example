# ==============================================================================
# AICB (AI Conversational Business Bot) Configuration
# ==============================================================================

# Application & Environment
APP_NAME="AICB Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8422
AICB_PORT=8422

# Database Configuration (PostgreSQL recommended for production, SQLite supported for quick local dev)
# For Docker Compose / Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://aicb_user:aicb_secure_pass_2026@postgres:5432/aicb"
# For Local Development SQLite:
DATABASE_URL="sqlite+aiosqlite:///./aicb.db"

# 1. AI Brain (Gemini default)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Optional alternatives:
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# 2. Channels (WhatsApp & Telegram)
META_WHATSAPP_TOKEN="your_whatsapp_system_user_token"
META_PHONE_NUMBER_ID="your_phone_number_id"
META_APP_SECRET=""
META_VERIFY_TOKEN="aicb_webhook_verification_token_secret"

TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="your_bot_username"  # no leading @, e.g. "my_store_bot" — used to redirect customers back into the chat after payment
WHATSAPP_BUSINESS_PHONE_NUMBER=""  # e.g. "2348012345678" (E.164, no "+") — used to redirect customers back into WhatsApp after payment

# 3. Payments (Paystack)
DEFAULT_PAYMENT_GATEWAY="paystack"
PAYSTACK_SECRET_KEY="sk_live_or_test_key"
PAYSTACK_PUBLIC_KEY="pk_live_or_test_key"
BOT_DOMAIN="https://aicb.sannex.ng"

# 4. AgentOS Remote Sync & Telemetry
SANNEX_API_KEY="snx_bot_xxxx"
SANNEX_HOST="https://agentos.aicb.sannex.ng"
ENABLE_TELEMETRY=true
SYNC_INTERVAL_MINUTES=30
